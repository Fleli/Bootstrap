3 7 19 13

struct Pair {
    word_16 x;
    word_16 y;
}

struct Box {
    word_16 prefix;
    Pair pair;
    word_16 suffix;
}

Box main() {
    Box box;
    box.prefix = 3;
    box.pair.x = 7;
    box.pair.y = 11;
    box.suffix = 13;

    Box* p = &box;
    word_16* field = &(*p).pair.y;
    *field = 17;
    (*p).pair.y = *field + 2;
    return box;
}
