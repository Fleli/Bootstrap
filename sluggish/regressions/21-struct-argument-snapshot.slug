3 7

struct Pair {
    word_16 x;
    word_16 y;
}

word_16 mutate(Pair* pair) {
    (*pair).x = 40;
    (*pair).y = 50;
    return 9;
}

Pair take(Pair first, word_16 ignored) {
    return first;
}

Pair main() {
    Pair first;
    first.x = 3;
    first.y = 7;
    return take(first, mutate(&first));
}
