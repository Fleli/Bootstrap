

struct Point {
    word_16 x;
    word_16 y;
}

struct Line {
    Point p1;
    Point p2;
}

word_16 main() {
    
    Point pt_1;
    pt_1.x = 4;
    pt_1.y = 5;
    
    Point pt_2;
    pt_2.x = pt_1.x;
    pt_2.y = pt_1.y + 1;
    
    Line l;
    l.p1 = pt_1;
    l.p2 = pt_2;
    
    word_16 sumy = l.p2.y + l.p1.y;
    return sumy;
    
}
